@model McDees.Web.Models.MenuItem
@{ ViewData["Title"] = "Customize"; }
<section class="customize-page"><a class="back-link" asp-action="Index">← Back to menu</a><div class="customize-card"><div class="feature-icon">@Model.Emoji</div><div><p class="eyebrow">@Model.Category</p><h1>@Model.Name</h1><p class="description">@Model.Description</p><p class="price">@Model.Price.ToString("C")</p><form asp-action="Add" method="post"><input type="hidden" name="id" value="@Model.Id" /><h2>Make it yours</h2>@foreach (var modifier in Model.Modifiers) { <label class="modifier"><input type="checkbox" name="modifiers" value="@modifier.Id" /><span>@modifier.Name</span><strong>@(modifier.Price == 0 ? "Included" : "+" + modifier.Price.ToString("C"))</strong></label> }<div class="quantity-row"><label>Quantity <input type="number" name="quantity" min="1" max="20" value="1" /></label><button class="checkout-button" type="submit">Add to order</button></div></form></div></div></section>
