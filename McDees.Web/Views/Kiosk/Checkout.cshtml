@model McDees.Web.Models.CheckoutViewModel
@{ ViewData["Title"] = "Review order"; }
<section class="checkout-page"><a class="back-link" asp-action="Index">← Keep shopping</a><h1>Review your order</h1><div class="checkout-card"><div>@foreach (var line in Model.Cart) { <div class="receipt-line"><span>@line.Quantity × @line.Name <small>@string.Join(", ", line.Modifiers.Select(x => x.Name))</small></span><strong>@line.LineTotal.ToString("C")</strong></div> }</div><div class="receipt-totals"><span>Subtotal <b>@Model.Subtotal.ToString("C")</b></span><span>Estimated tax <b>@Model.Tax.ToString("C")</b></span><strong>Total <b>@Model.Total.ToString("C")</b></strong></div><form asp-action="PlaceOrder" method="post"><p class="payment-note">Payment is simulated for this prototype. You will pay at pickup.</p><button class="checkout-button" type="submit">Place order →</button></form></div></section>
