@model IReadOnlyList<McDees.Web.Models.KitchenOrder>
@{ ViewData["Title"] = "Kitchen queue"; }
<section class="kitchen-page"><div class="kitchen-heading"><div><p class="eyebrow">KITCHEN PRODUCTION DISPLAY</p><h1>Make this next</h1><p>Advance each order as it moves through the kitchen.</p></div><a class="button" asp-controller="Staff" asp-action="Index">My shift</a></div><div class="kitchen-grid">@foreach (var status in new[] { "New", "Being Prepared", "Ready", "Completed" }) { var current = Model.Where(x => x.Status == status).ToList(); <section class="kitchen-column"><h2>@status <span>@current.Count</span></h2>@if (current.Count == 0) { <p class="empty-column">No orders</p> }@foreach (var order in current) { var minutes = Math.Max(0, (int)(DateTimeOffset.Now - order.CreatedAt).TotalMinutes); <article class="kitchen-ticket"><div class="ticket-top"><strong>#@order.OrderNumber</strong><span>@minutes min</span></div><p class="pickup-label">Pickup @order.PickupCode</p><ul>@foreach (var line in order.Lines) { <li>@line</li> }</ul>@if (status != "Completed") { <form asp-action="Advance" method="post"><input type="hidden" name="orderNumber" value="@order.OrderNumber" /><button type="submit">Mark @((status == "New" ? "being prepared" : status == "Being Prepared" ? "ready" : "completed")) →</button></form> }</article> }</section> }</div></section>
