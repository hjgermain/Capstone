@model McDees.Web.Models.LoginViewModel
@{ ViewData["Title"] = "Sign in"; }
<section class="login-page"><div class="login-card"><div class="login-icon">🍔</div><p class="eyebrow">WELCOME BACK</p><h1>Sign in to McDees</h1><p class="login-intro">Save your favorites and see your order history. Team members will be sent straight to their work dashboard.</p><form asp-action="Login" method="post"><input asp-for="ReturnUrl" type="hidden" /><div asp-validation-summary="ModelOnly" class="validation"></div><label asp-for="Email"></label><input asp-for="Email" autocomplete="email" placeholder="you@example.com" /><span asp-validation-for="Email" class="validation"></span><label asp-for="Password"></label><input asp-for="Password" autocomplete="current-password" placeholder="Your password" /><span asp-validation-for="Password" class="validation"></span><button class="checkout-button" type="submit">Sign in and continue</button></form><a class="back-link" asp-controller="Kiosk" asp-action="Index">← Continue ordering as a guest</a></div></section>
