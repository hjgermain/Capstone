@model IReadOnlyList<McDees.Web.Data.InventoryItem>
@{ ViewData["Title"] = "Inventory"; var lowStock = Model.Count(x => x.OnHandQuantity <= x.ReorderPoint); }
<section class="inventory-page"><div class="inventory-heading"><div><p class="eyebrow">SYSTEM-WIDE INVENTORY</p><h1>Inventory overview</h1><p>All stocked items across the McDees prototype. @lowStock item@(lowStock == 1 ? " is" : "s are") at or below the reorder point.</p></div><a class="button" asp-controller="Admin" asp-action="Index">Restaurant tools</a></div><div class="inventory-summary"><span><strong>@Model.Count</strong> active items</span><span><strong>@Model.Sum(x => x.OnHandQuantity * x.UnitCost).ToString("C")</strong> estimated on-hand value</span><span class="@(lowStock > 0 ? "warning" : "")"><strong>@lowStock</strong> reorder alerts</span></div><div class="inventory-table-wrap"><table class="inventory-table"><thead><tr><th>Item</th><th>Category</th><th>Store</th><th>On hand</th><th>Reorder at</th><th>Unit cost</th><th>Location</th></tr></thead><tbody>@foreach (var item in Model) { var low = item.OnHandQuantity <= item.ReorderPoint; <tr class="@(low ? "low-stock" : "")"><td><strong>@item.Name</strong>@if (low) { <span class="low-badge">Reorder</span> }</td><td>@item.Category</td><td>@item.StoreName</td><td>@item.OnHandQuantity @item.Unit</td><td>@item.ReorderPoint @item.Unit</td><td>@item.UnitCost.ToString("C")</td><td>@item.StorageLocation</td></tr> }</tbody></table></div></section>
