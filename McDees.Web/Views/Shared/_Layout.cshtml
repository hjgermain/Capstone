<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - McDees</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/McDees.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <a class="brand" asp-controller="Kiosk" asp-action="Index"><span>Mc</span>Dees</a>
        <div class="header-actions">
            @if (User.Identity?.IsAuthenticated == true)
            {
                @if (User.IsInRole("Admin") || User.IsInRole("Manager")) { <a asp-controller="Admin" asp-action="Index">Restaurant tools</a> }
                else if (User.IsInRole("Employee")) { <a asp-controller="Staff" asp-action="Index">My shift</a> }
                <form asp-controller="Account" asp-action="Logout" method="post"><button type="submit">Sign out</button></form>
            }
            else { <a class="login-link" asp-controller="Account" asp-action="Login">Sign in to your account</a> }
        </div>
    </header>
    <main role="main">@RenderBody()</main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
