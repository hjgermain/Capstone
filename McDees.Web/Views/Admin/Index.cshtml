@{ ViewData["Title"] = "Restaurant tools"; }
<section class="dashboard"><p class="eyebrow">MANAGER AREA</p><h1>Restaurant tools</h1><p class="dashboard-intro">This is the operational home for menu, orders, kitchen production, inventory, and reporting as those features are added.</p><div class="dashboard-grid"><article><span>🍔</span><h2>Menu & pricing</h2><p>Coming next: manage items, availability, prices, and images.</p></article><a class="dashboard-link" asp-controller="Kitchen" asp-action="Index"><article><span>🍳</span><h2>Kitchen display</h2><p>View live orders as they move from new to completed.</p></article></a><a class="dashboard-link" asp-controller="Inventory" asp-action="Index"><article><span>📦</span><h2>Inventory</h2><p>View every active inventory item and current reorder alerts.</p></article></a></div>@if (User.IsInRole("Admin")) { <section class="danger-zone"><h2>Prototype database</h2><p>Destroy all local McDees data, recreate the database, and restore the prototype accounts. This cannot be undone.</p>@if (TempData["Error"] is string error) { <p class="validation">@error</p> }<form asp-action="RebuildDatabase" method="post"><label for="confirmation">Type <strong>REBUILD</strong> to confirm</label><input id="confirmation" name="confirmation" autocomplete="off" /><button class="danger-button" type="submit">Destroy and rebuild database</button></form></section> }</section>
